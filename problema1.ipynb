   "source": [
    "import numpy as np"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "878672e0",
   "metadata": {},
   "source": [
    "# la funcion es \n",
    "$\\sum_{i=1}^{n=10} x^2-10\\cos(2π x_i)+10$"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 2,
   "id": "ecb030e8",
   "metadata": {},
   "outputs": [],
   "source": [
    "# definicion de funcion a resolver\n",
    "def f(x):\n",
    "    n = len(x)\n",
    "    return np.sum(x**2 - 10 * np.cos(2 * np.pi * x) + 10)"
   ]
  }
